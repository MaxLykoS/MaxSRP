#pragma kernel InspectGBuffer

Texture2D<float4> _ValidationAlbedo;
Texture2D<float4> _ValidationNormal;
Texture2D<float4> _ValidationMaterial;
Texture2D<float> _ValidationDepth;
Texture2D<float4> _ValidationMotion;
RWStructuredBuffer<uint> _ValidationCounts;
int2 _ValidationSize;
int _ValidationReversedZ;
int _ValidationHasMotion;

// Validation only: count actual GPU-written geometry/material pixels. This
// never participates in the terrain or the host's production frame resources.
[numthreads(8, 8, 1)]
void InspectGBuffer(uint3 dispatch : SV_DispatchThreadID)
{
    uint2 p = dispatch.xy;
    if (any(p >= (uint2)_ValidationSize)) return;
    InterlockedAdd(_ValidationCounts[0], 1);
    float depth = _ValidationDepth.Load(int3(p, 0));
    if (!isfinite(depth)) { InterlockedAdd(_ValidationCounts[9], 1); return; }
    bool geometry = _ValidationReversedZ != 0 ? depth > 1e-7 : depth < 1.0 - 1e-7;
    if (!geometry) return;
    InterlockedAdd(_ValidationCounts[1], 1);
    float4 albedo = _ValidationAlbedo.Load(int3(p, 0));
    float3 normal = _ValidationNormal.Load(int3(p, 0)).rgb * 2.0 - 1.0;
    float4 material = _ValidationMaterial.Load(int3(p, 0));
    if (all(isfinite(albedo)) && any(albedo.rgb > 1e-5)) InterlockedAdd(_ValidationCounts[2], 1);
    float length2 = dot(normal, normal);
    if (all(isfinite(normal)) && length2 > 0.8 && length2 < 1.2) InterlockedAdd(_ValidationCounts[3], 1);
    if (isfinite(material.b) && material.b > 1e-5 && material.b <= 1.0001) InterlockedAdd(_ValidationCounts[4], 1);
    if (!all(isfinite(albedo)) || !all(isfinite(normal)) || !all(isfinite(material))) InterlockedAdd(_ValidationCounts[9], 1);
    if (_ValidationHasMotion != 0)
    {
        float4 motion = _ValidationMotion.Load(int3(p, 0));
        if (!all(isfinite(motion))) InterlockedAdd(_ValidationCounts[9], 1);
        else if (motion.w > 0.5)
        {
            InterlockedAdd(_ValidationCounts[5], 1);
            if (dot(motion.xy, motion.xy) > 1e-12) InterlockedAdd(_ValidationCounts[7], 1);
        }
        else if (motion.w < -0.5) InterlockedAdd(_ValidationCounts[6], 1);
    }
}
