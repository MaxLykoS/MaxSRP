#pragma kernel TraceSky
#pragma kernel FinishSky
#pragma kernel TraceSurface

struct Triangle
{
    float3 vertex; uint material;
    float3 vertex1; float uv0x;
    float3 vertex2; float uv0y;
    float2 uv1; float2 uv2;
};
struct Node { float3 lower; int left; float3 upper; int right; };
struct MaterialData { float4 st; float4 flags; float4 wrapping; };
StructuredBuffer<Triangle> _Triangles;
StructuredBuffer<int> _TriangleOrder;
StructuredBuffer<Node> _Nodes;
StructuredBuffer<MaterialData> _Materials;
Texture2DArray<float> _Alpha;
SamplerState sampler_Alpha;
Texture2D<float4> _Positions;
Texture2D<float4> _Normals;
RWTexture2D<float2> _Accumulation;
RWTexture2D<float> _Finished;
struct SurfaceTexel { uint pixel; uint chart; uint originStart; uint originCount; };
struct SurfaceOrigin { float3 position; uint material; float3 normal; uint sourceTriangle; float2 uv; };
StructuredBuffer<SurfaceTexel> _SurfaceTexels;
StructuredBuffer<SurfaceOrigin> _SurfaceOrigins;
RWStructuredBuffer<float2> _SurfaceAccumulation;
struct SurfaceFragmentRange { uint firstFragment; uint fragmentCount; float totalUvArea; float reserved; };
struct SurfaceFragment { float3 p0;uint material;float3 p1;uint sourceTriangle;float3 p2;float cdf;float3 normal;float uvArea;float2 uv0;float2 uv1;float2 uv2; };
StructuredBuffer<SurfaceFragmentRange> _SurfaceFragmentRanges;
StructuredBuffer<SurfaceFragment> _SurfaceFragments;
int _UseContinuousOrigins, _OccluderTwoSided, _RobustRayOrigin, _RobustIntersections;
int _SurfaceStart, _SurfaceCount;
int2 _TileOrigin;
int _Size, _SampleStart, _SamplesPerBatch, _SampleCount;
float _RayDistance, _RayOffset;

uint Hash(uint v) { v ^= v >> 16; v *= 0x7feb352d; v ^= v >> 15; v *= 0x846ca68b; return v ^ (v >> 16); }
float Random(uint v) { return (Hash(v) >> 8) * (1.0 / 16777216.0); }
float RadicalInverse(uint bits)
{
    bits = (bits << 16) | (bits >> 16);
    bits = ((bits & 0x55555555u) << 1) | ((bits & 0xaaaaaaaau) >> 1);
    bits = ((bits & 0x33333333u) << 2) | ((bits & 0xccccccccu) >> 2);
    bits = ((bits & 0x0f0f0f0fu) << 4) | ((bits & 0xf0f0f0f0u) >> 4);
    bits = ((bits & 0x00ff00ffu) << 8) | ((bits & 0xff00ff00u) >> 8);
    return bits * 2.3283064365386963e-10;
}
float Wrap(float v, int mode)
{
    if (mode == 1) return saturate(v);
    if (mode == 2) return 1 - abs(frac(v * 0.5) * 2 - 1);
    if (mode == 4) return saturate(abs(v));
    return frac(v);
}
bool BoxHit(float3 o, float3 inverseD, float3 lo, float3 hi)
{
    float3 a = (lo - o) * inverseD, b = (hi - o) * inverseD;
    float3 mn = min(a, b), mx = max(a, b);
    return max(max(mn.x, mn.y), max(mn.z, 0)) <= min(min(mx.x, mx.y), min(mx.z, _RayDistance));
}
// Absolute shared vertices and consistent projected edge tests avoid cracks
// caused by rebuilding a shared vertex from rounded base+edge values.
bool SurfaceTriangleHit(Triangle tri, float3 o, float3 d, out float distance, out float2 bary)
{
    float3 e1=tri.vertex1-tri.vertex,e2=tri.vertex2-tri.vertex;
    distance=0;bary=0;
    if(_RobustIntersections==0)
    {
        float3 p=cross(d,e2);float det=dot(e1,p);
        if(abs(det)<1e-10)return false;
        float inv=rcp(det);float3 rel=o-tri.vertex;
        float u=dot(rel,p)*inv;float3 q=cross(rel,e1);float v=dot(d,q)*inv;
        distance=dot(e2,q)*inv;bary=float2(u,v);
        return u>=0 && v>=0 && u+v<=1;
    }
    float3 ad=abs(d);int kz=ad.x>ad.y?(ad.x>ad.z?0:2):(ad.y>ad.z?1:2);
    int kx=kz==2?0:kz+1,ky=kx==2?0:kx+1;if(d[kz]<0){int swap=kx;kx=ky;ky=swap;}
    float sx=d[kx]/d[kz],sy=d[ky]/d[kz],sz=rcp(d[kz]);
    float3 a=tri.vertex-o,b=tri.vertex1-o,c=tri.vertex2-o;
    precise float ax=a[kx]-sx*a[kz],ay=a[ky]-sy*a[kz];
    precise float bx=b[kx]-sx*b[kz],by=b[ky]-sy*b[kz];
    precise float cx=c[kx]-sx*c[kz],cy=c[ky]-sy*c[kz];
    precise float u=cx*by-cy*bx,v=ax*cy-ay*cx,w=bx*ay-by*ax;
    if((min(u,min(v,w))<0) && (max(u,max(v,w))>0))return false;
    precise float det=u+v+w;if(det==0)return false;
    // The projected barycentric distance can subtract large almost equal
    // terms for a millimetre-separated receiver and a very large roof.
    // Evaluate its plane equation after normal scaling instead.
    float3 plane=cross(e1,e2);float planeScale=max(abs(plane.x),max(abs(plane.y),abs(plane.z)));
    if(planeScale==0)return false;plane/=planeScale;
    float planeDenominator=dot(plane,d);if(planeDenominator==0)return false;
    distance=dot(tri.vertex-o,plane)/planeDenominator;bary=float2(v,w)/det;
    return true;
}
float3 SurfaceRayOrigin(float3 p,float3 n)
{
    if(_RobustRayOrigin==0)return p+n*_RayOffset;
    // Preserve thin blockers: skip the source primitive by identity and move
    // only a few representable coordinates, rather than a fixed world-space 2mm.
    int3 steps=(int3)round(n*8.0);
    int3 bits=asint(p)+int3(p.x<0?-steps.x:steps.x,p.y<0?-steps.y:steps.y,p.z<0?-steps.z:steps.z);
    float3 shifted=asfloat(bits);
    return float3(abs(p.x)<.03125?p.x+n.x*9.5367431640625e-7:shifted.x,
                  abs(p.y)<.03125?p.y+n.y*9.5367431640625e-7:shifted.y,
                  abs(p.z)<.03125?p.z+n.z*9.5367431640625e-7:shifted.z);
}
bool Blocked(float3 o, float3 d, uint sourceTriangle)
{
    float3 inverseD=rcp(d+float3(d.x==0?1e-20:0,d.y==0?1e-20:0,d.z==0?1e-20:0));
    int stack[48];int top=0;stack[top++]=0;
    [loop]while(top>0)
    {
        Node node=_Nodes[stack[--top]];
        if(!BoxHit(o,inverseD,node.lower,node.upper))continue;
        if(node.left>=0){stack[top++]=node.left;stack[top++]=node.right;continue;}
        int first=-node.left-1;
        [loop]for(int j=0;j<node.right;++j)
        {
            uint id=(uint)_TriangleOrder[first+j];
            if(_RobustRayOrigin!=0 && id==sourceTriangle)continue;
            Triangle tri=_Triangles[id];MaterialData material=_Materials[tri.material];
            // Occlusion sidedness is independent of which side is rasterized or receives light.
            if(_OccluderTwoSided==0 && material.flags.z<.5 && dot(cross(tri.vertex1-tri.vertex,tri.vertex2-tri.vertex),d)>=0)continue;
            float distance;float2 bary;
            if(!SurfaceTriangleHit(tri,o,d,distance,bary))continue;
            if(distance<=(_RobustRayOrigin!=0?0:1e-5) || distance>=_RayDistance)continue;
            if(material.flags.x>0)
            {
                float2 uv=float2(tri.uv0x,tri.uv0y)*(1-bary.x-bary.y)+tri.uv1*bary.x+tri.uv2*bary.y;
                uv=uv*material.st.xy+material.st.zw;
                uv=float2(Wrap(uv.x,(int)material.wrapping.x),Wrap(uv.y,(int)material.wrapping.y));
                if(_Alpha.SampleLevel(sampler_Alpha,float3(uv,material.flags.y),0)<material.flags.x)continue;
            }
            return true;
        }
    }
    return false;
}
[numthreads(8, 8, 1)]
void TraceSky(uint3 tid : SV_DispatchThreadID)
{
    int2 p = _TileOrigin + tid.xy;
    if (any(p >= _Size)) return;
    float4 position = _Positions[p];
    if (position.w < 0.5) return;
    float3 n = normalize(_Normals[p].xyz);
    float2 sum = _SampleStart == 0 ? 0 : _Accumulation[p];
    uint seed = (uint)p.x + (uint)p.y * (uint)_Size;
    float2 rotation = float2(Random(seed * 2), Random(seed * 2 + 1));
    [loop] for (int i = 0; i < _SamplesPerBatch; ++i)
    {
        int sampleIndex = _SampleStart + i;
        if (sampleIndex >= _SampleCount) break;
        float2 xi = frac(float2((sampleIndex + 0.5) / _SampleCount, RadicalInverse(sampleIndex)) + rotation);
        // Uniform world-space upper hemisphere. Weight by the receiving plane cosine;
        // divide by the matching unobstructed integral, so exposed tilted surfaces are 1.
        float y = xi.x;
        float r = sqrt(max(0, 1 - y * y));
        float angle = 6.28318530718 * xi.y;
        float3 d = float3(r * cos(angle), y, r * sin(angle));
        float weight = max(0, dot(n, d));
        sum.y += weight;
        if (weight > 0 && !Blocked(position.xyz + n * _RayOffset, d, 0xffffffffu)) sum.x += weight;
    }
    _Accumulation[p] = sum;
}
[numthreads(8, 8, 1)]
void FinishSky(uint3 tid : SV_DispatchThreadID)
{
    int2 p = _TileOrigin + tid.xy;
    if (any(p >= _Size)) return;
    float2 value = _Accumulation[p];
    if (_Positions[p].w < 0.5)
    {
        // Closest occupied texel wins. Never blur receiving surfaces or mix chart values.
        int bestDistance = 100000;
        [loop] for (int y = -4; y <= 4; ++y)
        [loop] for (int x = -4; x <= 4; ++x)
        {
            int2 q = p + int2(x,y);
            int distance = x*x + y*y;
            if (distance >= bestDistance || any(q < 0) || any(q >= _Size)) continue;
            if (_Positions[q].w > 0.5) { value = _Accumulation[q]; bestDistance = distance; }
        }
    }
    _Finished[p] = value.y > 1e-6 ? saturate(value.x / value.y) : 1;
}

// Sample the geometric normal hemisphere, matching the full-sphere diffuse IBL
// domain. A scalar transfer assumes uniform incident radiance; it cannot represent
// directional sky colour or indirect reflected radiance.
bool OriginCovered(SurfaceOrigin o)
{
    MaterialData m = _Materials[o.material];
    if (m.flags.x <= 0) return true;
    float2 uv = o.uv * m.st.xy + m.st.zw;
    uv = float2(Wrap(uv.x, (int)m.wrapping.x), Wrap(uv.y, (int)m.wrapping.y));
    return _Alpha.SampleLevel(sampler_Alpha, float3(uv, m.flags.y), 0) >= m.flags.x;
}
[numthreads(64, 1, 1)]
void TraceSurface(uint3 tid : SV_DispatchThreadID)
{
    uint index = (uint)_SurfaceStart + tid.x;
    if (index >= (uint)_SurfaceCount) return;
    SurfaceTexel t = _SurfaceTexels[index];
    float2 sum = _SampleStart == 0 ? 0 : _SurfaceAccumulation[index];
    uint seed = t.pixel;
    float2 rotation = float2(Random(seed * 2), Random(seed * 2 + 1));
    [loop] for (int i = 0; i < _SamplesPerBatch; ++i)
    {
        uint sampleIndex = (uint)(_SampleStart + i);
        if (sampleIndex >= (uint)_SampleCount) break;
        SurfaceOrigin o;
        if(_UseContinuousOrigins!=0)
        {
            SurfaceFragmentRange range=_SurfaceFragmentRanges[index];
            float choose=Random(Hash(seed^0x68bc21ebu)^Hash(sampleIndex));
            uint selected=range.firstFragment+range.fragmentCount-1;
            [loop]for(uint k=0;k<range.fragmentCount;++k){uint f=range.firstFragment+k;if(choose<_SurfaceFragments[f].cdf){selected=f;break;}}
            SurfaceFragment fragment=_SurfaceFragments[selected];
            float r=sqrt(Random(Hash(seed^0x02e5be93u)^Hash(sampleIndex+0x9e3779b9u)));
            float v=Random(Hash(seed^0x967a889bu)^Hash(sampleIndex+0x85ebca6bu));
            float2 bary=float2(r*(1-v),r*v);
            o.position=fragment.p0+(fragment.p1-fragment.p0)*bary.x+(fragment.p2-fragment.p0)*bary.y;
            o.uv=fragment.uv0+(fragment.uv1-fragment.uv0)*bary.x+(fragment.uv2-fragment.uv0)*bary.y;
            o.normal=fragment.normal;o.material=fragment.material;o.sourceTriangle=fragment.sourceTriangle;
        }
        else
        {
            uint choice=Hash(sampleIndex^Hash(seed))%t.originCount;
            o=_SurfaceOrigins[t.originStart+choice];
        }
        if (!OriginCovered(o)) continue;
        float2 xi = frac(float2((sampleIndex + 0.5) / _SampleCount, RadicalInverse(sampleIndex)) + rotation);
        float3 n = normalize(o.normal);
        float3 tangent = normalize(cross(abs(n.y) < .999 ? float3(0,1,0) : float3(1,0,0), n));
        float3 bitangent = cross(n, tangent);
        float radius = sqrt(xi.x), angle = 6.28318530718 * xi.y;
        float3 d = tangent * (radius*cos(angle)) + bitangent * (radius*sin(angle)) + n * sqrt(max(0,1-xi.x));
        sum.y += 1;
        if (!Blocked(SurfaceRayOrigin(o.position,n), d, o.sourceTriangle)) sum.x += 1;
    }
    _SurfaceAccumulation[index] = sum;
}

